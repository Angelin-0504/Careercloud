# =====================================================================
# CareerCloud - Environment Variables Configuration Template
# Copy this file to '.env' and customize for your environment.
# =====================================================================

# --- General Application Settings ---
PROJECT_NAME="CareerCloud API"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development" # Set to "production" in AWS
DEBUG=True

# --- Security & JWT Settings ---
# Generate a secure 32+ character key for production (e.g. using `openssl rand -hex 32`)
SECRET_KEY="careercloud-super-secret-development-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# --- Database Tier (PostgreSQL / SQLite) ---
# OPTION A: Out-of-the-box local development (Zero setup SQLite):
DATABASE_URL="sqlite:///./careercloud.db"

# OPTION B: Supabase Free PostgreSQL (Recommended for ₹0 Cloud Production):
# Get from Supabase -> Project Settings -> Database -> Connection String (URI / Session Pooler)
# DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# OPTION C: Amazon RDS or Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/careercloud"

# --- Storage Tier (Local vs Cloud S3 / Supabase Storage) ---
# Choose "local" for development, "s3" for Supabase Storage or AWS S3
STORAGE_TYPE="local"

# Local Storage Directory (Used when STORAGE_TYPE="local")
LOCAL_STORAGE_DIR="./uploads/resumes"
MAX_FILE_SIZE_MB=5

# Cloud Storage Settings (Used when STORAGE_TYPE="s3")
# For Supabase Free S3-Compatible Storage:
# Get S3 keys from: Supabase -> Project Settings -> Storage -> S3 Access Keys -> Generate Key
# AWS_ENDPOINT_URL="https://[project-ref].storage.supabase.co/v1/s3"
# AWS_ACCESS_KEY_ID="[supabase-s3-access-key-id]"
# AWS_SECRET_ACCESS_KEY="[supabase-s3-secret-access-key]"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET_NAME="resumes"

# For AWS S3:
# AWS_ENDPOINT_URL=""
# AWS_ACCESS_KEY_ID="[aws-access-key]"
# AWS_SECRET_ACCESS_KEY="[aws-secret-key]"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET_NAME="careercloud-resumes-bucket"

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
