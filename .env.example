# =====================================================================
# CareerCloud - Environment Variables Configuration Template
# Copy this file to '.env' and customize for your environment.
# =====================================================================

# --- General Application Settings ---
PROJECT_NAME="CareerCloud API"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development" # Set to "production" in AWS
DEBUG=True

# --- Security & JWT Settings ---
# Generate a secure 32+ character key for production (e.g. using `openssl rand -hex 32`)
SECRET_KEY="careercloud-super-secret-development-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# --- Database Tier (PostgreSQL / SQLite) ---
# OPTION A: Out-of-the-box local development (Zero setup SQLite):
DATABASE_URL="sqlite:///./careercloud.db"

# OPTION B: Local PostgreSQL instance or Docker:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/careercloud"

# OPTION C: Amazon RDS Managed PostgreSQL (AWS Production):
# DATABASE_URL="postgresql://careeradmin:YourStrongPassword@careercloud-db.c9xxx.us-east-1.rds.amazonaws.com:5432/careercloud"

# --- Storage Tier (Local vs AWS S3 Object Storage) ---
# Choose "local" for development, "s3" for AWS deployment
STORAGE_TYPE="local"

# Local Storage Directory (Used when STORAGE_TYPE="local")
LOCAL_STORAGE_DIR="./uploads/resumes"
MAX_FILE_SIZE_MB=5

# Amazon S3 Bucket Settings (Used when STORAGE_TYPE="s3")
# Leave empty during local development so you don't incur AWS charges.
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="careercloud-resumes-private-bucket"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
